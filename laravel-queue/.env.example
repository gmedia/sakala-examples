# Copy to .env for local development: cp .env.example .env && php artisan key:generate
# On Sakala, set these in the project's Variabel tab instead. An attached
# database sets DATABASE_URL and DB_*, and an attached Valkey store sets
# REDIS_URL, REDIS_HOST, REDIS_PORT, and REDIS_PASSWORD. The .env file is never
# deployed.

APP_NAME="Antrean Laravel Sakala"
APP_ENV=local
# Required. Generate one with: php artisan key:generate --show
# On Sakala, save it as a secret. Never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Times on the page are shown in this zone; the database keeps UTC.
APP_DISPLAY_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database. Leave all of these empty and the app still starts: it shows how to
# attach a database, and `php artisan migrate --force` runs against a throwaway
# in-memory SQLite database. Set DATABASE_URL (or DB_URL, or DB_HOST and the
# rest) to use PostgreSQL. For a local SQLite file instead:
# DB_CONNECTION=sqlite, then touch database/database.sqlite
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# DB_CONNECTION=sqlite

# Valkey or Redis. With REDIS_URL set, the queue, cache, and session use it.
# Without it, jobs wait in the database's `jobs` table, the cache uses files,
# and the session an encrypted cookie. Leave the database number out of the
# URL: Laravel keeps the queue in database 0 and the cache in database 1.
# REDIS_URL=redis://127.0.0.1:6379

# Set these only to override the choice above.
# QUEUE_CONNECTION=database
# CACHE_STORE=file
# SESSION_DRIVER=cookie
